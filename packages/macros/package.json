{
  "name": "@vue-jsx/macros",
  "version": "3.3.0-beta.1",
  "description": "Macros for Vue JSX",
  "keywords": [
    "macros",
    "transform",
    "vapor",
    "volar",
    "vue-jsx"
  ],
  "homepage": "https://github.com/vuejs/vue-jsx-vapor#readme",
  "bugs": {
    "url": "https://github.com/vuejs/vue-jsx-vapor/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuejs/vue-jsx-vapor.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./astro": "./dist/astro.js",
    "./rspack": "./dist/rspack.js",
    "./rsbuild": "./dist/rsbuild.js",
    "./vite": "./dist/vite.js",
    "./webpack": "./dist/webpack.js",
    "./rollup": "./dist/rollup.js",
    "./esbuild": "./dist/esbuild.js",
    "./nuxt": "./dist/nuxt.js",
    "./bun": "./dist/bun.js",
    "./api": "./dist/api.js",
    "./raw": "./dist/raw.js",
    "./volar": "./dist/volar.js",
    "./*": "./*"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "DEV=true vp pack",
    "typecheck": "tsmc --noEmit && tsmc -p playground --noEmit",
    "play": "vp ./playground",
    "play:build": "vp build ./playground"
  },
  "dependencies": {
    "hash-sum": "catalog:",
    "magic-string": "^0.30.21",
    "ts-macro": "^0.3.7",
    "unplugin": "catalog:",
    "unplugin-utils": "catalog:"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.3",
    "@babel/types": "^7.29.0",
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@shikijs/vitepress-twoslash": "^4.0.2",
    "@ts-macro/tsc": "^0.3.7",
    "@ts-macro/twoslash": "^0.0.5",
    "@types/hash-sum": "catalog:",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue-macros/volar": "catalog:",
    "ast-kit": "^2.2.0",
    "typescript": "^6.0.3",
    "vite-plugin-inspect": "^11.3.3",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3",
    "@nuxt/schema": "^3",
    "esbuild": "*",
    "rolldown": "*",
    "rollup": "^3",
    "vite": ">=3",
    "vue": ">=3",
    "webpack": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "@nuxt/schema": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  }
}
